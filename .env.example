# Supabase Configuration Template for HIMASI
# Ganti dengan URL dan Publishable/Anon Key proyek Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Google Apps Script Email Relay Webhook Configuration
HIMASI_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
HIMASI_EMAIL_SECRET_TOKEN=your-secret-token-here

# Supabase Auth "Send Email" Hook Secret (Rekomendasi Keamanan: Mengamankan endpoint POST /api/auth/send-email via HMAC-SHA256 Svix)
# Ambil dari: Supabase Dashboard -> Authentication -> Hooks -> Send Email Hook -> Webhook Secret (awalan v1,whsec_...)
SUPABASE_AUTH_HOOK_SECRET=your-supabase-hook-secret-here
